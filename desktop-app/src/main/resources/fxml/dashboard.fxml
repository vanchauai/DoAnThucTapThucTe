<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.Group?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doanthuctap.desktop.controller.DashboardController" style="-fx-background-color: transparent; -fx-padding: 30;">
    
    <!-- Top Banner Section -->
    <HBox style="-fx-background-color: linear-gradient(to right, #173B62, #0F1D30); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4); -fx-padding: 20 30;" alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label fx:id="lblGreeting" text="Chào buổi sáng," style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Chào mừng trở lại bảng điều khiển phân tích dữ liệu." style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" />
        </VBox>
        <Label fx:id="lblRoleBadge" text="Vai trò" style="-fx-background-color: #00A8E8; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 14px;" />
    </HBox>

    <!-- Metrics Cards Section -->
    <HBox spacing="20">
        <!-- Card 1: Total Data Sources -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane style="-fx-background-color: #E0E7FF; -fx-background-radius: 10; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;">
                    <SVGPath content="M4 6h16v12H4zm2 2v8h12V8H6zm2 2h8v2H8v-2z" fill="#4F46E5" scaleX="1.2" scaleY="1.2"/>
                </StackPane>
                <Label text="Nguồn dữ liệu" style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="142" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                <Label text="+12%" style="-fx-text-fill: #10B981; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
        </VBox>
        
        <!-- Card 2: Analyzed Records -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane style="-fx-background-color: #DCFCE7; -fx-background-radius: 10; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;">
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-2V7h2v5zm4 0h-2V9h2v3zm-8 0H6v-2h2v2zm8 4H6v-2h12v2z" fill="#16A34A" scaleX="1.2" scaleY="1.2"/>
                </StackPane>
                <Label text="Bản ghi đã xử lý" style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="1.2M" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                <Label text="+8.4%" style="-fx-text-fill: #10B981; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
        </VBox>

        <!-- Card 3: System Alerts -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane style="-fx-background-color: #FEE2E2; -fx-background-radius: 10; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;">
                    <SVGPath content="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" fill="#EF4444" scaleX="1.1" scaleY="1.1"/>
                </StackPane>
                <Label text="Cảnh báo hệ thống" style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="3" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                <Label text="Cần xử lý" style="-fx-text-fill: #EF4444; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Main Content Area: Chart Placeholder and CTA -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Left: Large Chart Placeholder -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="15">
            <Label text="Tổng quan lưu lượng dữ liệu" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            <StackPane VBox.vgrow="ALWAYS" style="-fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-color: #F8FAFC; -fx-background-radius: 8;">
                <VBox alignment="CENTER" spacing="10">
                    <SVGPath content="M3,3 L3,21 L21,21 L21,19 L5,19 L5,3 L3,3 Z M7,17 L11,17 L11,9 L7,9 L7,17 Z M13,17 L17,17 L17,5 L13,5 L13,17 Z" fill="#CBD5E1" scaleX="3.0" scaleY="3.0" />
                    <Label text="Đang tải dữ liệu biểu đồ..." style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;">
                        <VBox.margin>
                            <Insets top="20" />
                        </VBox.margin>
                    </Label>
                </VBox>
            </StackPane>
        </VBox>

        <!-- Right: Action Panel (Replacing old center UI) -->
        <VBox style="-fx-background-color: linear-gradient(to bottom right, #3FA9F5, #21519C); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4); -fx-padding: 30;" minWidth="300" maxWidth="300" alignment="CENTER" spacing="25">
            <Group scaleX="2.5" scaleY="2.5">
                <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z M7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z" fill="white" opacity="0.9" />
                <SVGPath content="M16 11l-3-3-3 3-4-4v3l4 4 3-3 3 3 3-3z" fill="#80D0FF" opacity="0.9" />
            </Group>
            
            <VBox alignment="CENTER" spacing="10">
                <Label text="SmartSyncVN" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 0, 2);" />
                <Label text="Đồng bộ &amp; Phân tích" style="-fx-text-fill: #E0F2FE; -fx-font-size: 14px;" />
            </VBox>
            
            <Button text="Khám phá ngay" onAction="#handleDiscover" style="-fx-background-color: white; -fx-text-fill: #1D4ED8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);" />
        </VBox>
    </HBox>

</VBox>
