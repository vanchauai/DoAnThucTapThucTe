<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<VBox spacing="25" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doanthuctap.desktop.controller.ReportController" style="-fx-background-color: transparent;">
    
    <stylesheets>
        <URL value="@../css/dark-theme.css" />
    </stylesheets>

    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Báo Cáo Phân Tích" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Tạo và quản lý các báo cáo định kỳ" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
        </VBox>
    </HBox>

    <!-- Filters & Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #162842; -fx-padding: 15 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4);">
        <Label text="Kỳ báo cáo:" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px; -fx-font-weight: bold;" />
        <ComboBox fx:id="cbPeriod" prefWidth="130" />
        <TextField fx:id="txtPeriodValue" prefWidth="130" promptText="VD: 08/2026" style="-fx-background-color: #0F1D30; -fx-border-color: #334155; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: white; -fx-prompt-text-fill: #64748B; -fx-padding: 6 10;" />
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Button text="Tạo báo cáo" onAction="#handleGenerateReport" style="-fx-background-color: #00A8E8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
            <graphic>
                <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="white" scaleX="0.8" scaleY="0.8" />
            </graphic>
        </Button>
    </HBox>

    <!-- Table Container -->
    <VBox VBox.vgrow="ALWAYS" spacing="15" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Lịch sử xuất báo cáo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            
            <Button fx:id="btnViewDetail" text="Xem chi tiết" onAction="#handleViewDetail" disable="true" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
                <graphic>
                    <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="white" scaleX="0.7" scaleY="0.7" />
                </graphic>
            </Button>
            
            <Button fx:id="btnDelete" text="Xóa" onAction="#handleDelete" disable="true" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
                <graphic>
                    <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="white" scaleX="0.7" scaleY="0.7" />
                </graphic>
            </Button>
        </HBox>
        
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                <TableColumn fx:id="colName" text="Tên báo cáo" prefWidth="250" />
                <TableColumn fx:id="colPeriod" text="Kỳ báo cáo" prefWidth="150" />
                <TableColumn fx:id="colCreatedAt" text="Ngày tạo" prefWidth="180" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
    
</VBox>
