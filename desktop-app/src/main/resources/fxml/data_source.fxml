<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<VBox spacing="25" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doanthuctap.desktop.controller.DataSourceController" style="-fx-background-color: transparent;">
    
    <stylesheets>
        <URL value="@../css/dark-theme.css" />
    </stylesheets>

    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Quản lý Nguồn dữ liệu" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Kết nối và đồng bộ các luồng dữ liệu của bạn" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
        </VBox>
        
        <!-- Action Buttons -->
        <HBox spacing="10">
            <Button fx:id="btnUpload" text="Upload File" onAction="#handleUpload" style="-fx-background-color: #1E2D40; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8; -fx-graphic-text-gap: 8;">
                <graphic>
                    <SVGPath content="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" fill="#94A3B8" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
            
            <Button fx:id="btnConnectGSheets" text="Google Sheets" onAction="#handleConnectGSheets" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
                <graphic>
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-2V7h2v5zm4 0h-2V9h2v3zm-8 0H6v-2h2v2zm8 4H6v-2h12v2z" fill="white" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
            
            <Button fx:id="btnSync" text="Đồng bộ" onAction="#handleSync" disable="true" style="-fx-background-color: #00A8E8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
                <graphic>
                    <SVGPath content="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" fill="white" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
            
            <Button fx:id="btnDelete" text="Xóa" onAction="#handleDelete" disable="true" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
                <graphic>
                    <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="white" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Table Container with Shadow and rounded corners -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 10;">
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                <TableColumn fx:id="colName" text="Tên nguồn" prefWidth="250" />
                <TableColumn fx:id="colType" text="Loại" prefWidth="120" />
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" />
                <TableColumn fx:id="colLastSync" text="Đồng bộ lần cuối" prefWidth="180" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
    
</VBox>
