<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import java.net.URL?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="25" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doanthuctap.desktop.controller.ReportDetailController" style="-fx-background-color: #12243D;">
    
    <stylesheets>
        <URL value="@../css/dark-theme.css" />
    </stylesheets>
    
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Chi tiết Báo cáo" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Thống kê chi tiết các chỉ số kinh doanh" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
        </VBox>
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="20" alignment="CENTER">
        <!-- Total Revenue -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #047857; -fx-background-radius: 8; -fx-padding: 8;">
                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="white" scaleX="0.8" scaleY="0.8" />
                </StackPane>
                <Label text="Tổng Doanh Thu" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
            <Label fx:id="lblTotalRevenue" text="0 VNĐ" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </VBox>
        
        <!-- Revenue Change -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #00A8E8; -fx-background-radius: 8; -fx-padding: 8;">
                    <SVGPath content="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z" fill="white" scaleX="0.8" scaleY="0.8" />
                </StackPane>
                <Label text="Tăng trưởng" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
            <Label fx:id="lblRevenueChange" text="0%" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </VBox>
        
        <!-- Total Orders -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #8B5CF6; -fx-background-radius: 8; -fx-padding: 8;">
                    <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" fill="white" scaleX="0.8" scaleY="0.8" />
                </StackPane>
                <Label text="Tổng Đơn Hàng" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
            <Label fx:id="lblTotalOrders" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </VBox>
        
        <!-- Avg Revenue -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #F59E0B; -fx-background-radius: 8; -fx-padding: 8;">
                    <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="white" scaleX="0.8" scaleY="0.8" />
                </StackPane>
                <Label text="Doanh Thu TB / Đơn" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>
            <Label fx:id="lblAvgRevenue" text="0 VNĐ" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </VBox>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Chart -->
        <VBox style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;" HBox.hgrow="ALWAYS" prefWidth="500">
            <Label text="Biểu đồ doanh thu" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 10 0;" />
            <BarChart fx:id="revenueChart" VBox.vgrow="ALWAYS" legendVisible="false" style="-fx-text-fill: white;">
                <xAxis>
                    <CategoryAxis label="Thời gian" tickLabelFill="#94A3B8" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Doanh thu (VNĐ)" tickLabelFill="#94A3B8" />
                </yAxis>
            </BarChart>
        </VBox>
        
        <!-- Data Tables -->
        <VBox spacing="20" prefWidth="350">
            <!-- Top Products -->
            <VBox style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 10;" VBox.vgrow="ALWAYS">
                <Label text="Top Sản Phẩm (Số lượng)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 10;" />
                <TableView fx:id="tblTopProducts" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProductName" text="Tên Sản Phẩm" prefWidth="200" />
                        <TableColumn fx:id="colProductQuantity" text="SL" prefWidth="100" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </HBox>
    
    <HBox alignment="CENTER_RIGHT">
        <Button text="Đóng" onAction="#handleClose" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>

</VBox>
