<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<VBox spacing="25" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doanthuctap.desktop.controller.UserManagementController" style="-fx-padding: 30; -fx-background-color: transparent;">
    
    <stylesheets>
        <URL value="@../css/dark-theme.css" />
    </stylesheets>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Quản lý Người dùng" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Thêm, sửa, xóa và phân quyền tài khoản hệ thống" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
        </VBox>
        
        <Button text="Thêm người dùng" onAction="#handleAddUser" style="-fx-background-color: #00A8E8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-graphic-text-gap: 8;">
            <graphic>
                <SVGPath content="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="white" scaleX="0.8" scaleY="0.8" />
            </graphic>
        </Button>
    </HBox>

    <!-- Table Container -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 10;">
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="250">
                    <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colName" text="Họ Tên" prefWidth="250">
                    <cellValueFactory><PropertyValueFactory property="fullName" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colRole" text="Vai trò" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" />
                <TableColumn fx:id="colActions" text="Hành động" prefWidth="200" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
