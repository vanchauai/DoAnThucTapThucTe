<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 30; -fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doanthuctap.desktop.controller.PredictionController">
    <stylesheets>
        <URL value="@../css/dark-theme.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Phân tích &amp; Dự đoán doanh thu" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Theo dõi xu hướng và dự báo tương lai" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
        </VBox>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="15" style="-fx-background-color: #162842; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-padding: 20;">
        <!-- Chart -->
        <LineChart fx:id="revenueChart" VBox.vgrow="ALWAYS" legendSide="TOP" style="-fx-text-fill: white;">
            <xAxis>
                <CategoryAxis side="BOTTOM" label="Ngày" animated="false" tickLabelFill="#94A3B8" />
            </xAxis>
            <yAxis>
                <NumberAxis side="LEFT" label="Doanh thu (VNĐ)" animated="false" tickLabelFill="#94A3B8" />
            </yAxis>
        </LineChart>
    </VBox>

    <!-- Warnings VBox -->
    <VBox fx:id="vboxWarnings" spacing="10" style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-padding: 15; -fx-border-color: #EF4444; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4);">
        <Label text="Cảnh báo bất thường (Outliers):" style="-fx-font-weight: bold; -fx-text-fill: #FCA5A5; -fx-font-size: 14px;" />
    </VBox>
</VBox>
